{
----------------------------------------------------------------------------------------------------
    Filename:       FXOS8700-Demo.spin2
    Description:    Demo of the FXOS8700 driver
        * 6DoF data output
    Author:         Jesse Burt
    Started:        Sep 19, 2020
    Updated:        Jul 8, 2024
    Copyright (c) 2024 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    _clkfreq    = cfg._clkfreq_def
    _xtlfreq    = cfg._xtlfreq

#include "core.con.click.spin2"
' -- User-modifiable constants
    CLICK_BASE  = 16                            ' MikroE Click board base I/O pin (multiple of 16)
'--

OBJ

    cfg:    "boardcfg.p2eval"

    { MikroE Click boards (change CLICK_BASE above) }
    'sensor: "sensor.imu.6dof.fxos8700" | SCL=SCL_PIN, SDA=SDA_PIN, I2C_FREQ=400_000, I2C_ADDR=%11

    { custom I/O settings }
    sensor: "sensor.imu.6dof.fxos8700" | SCL=0, SDA=1, I2C_FREQ=400_000, I2C_ADDR=%11, RST_PIN=-1

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000


PUB setup()

    ser.start()

    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"FXOS8700 driver started")
    else
        ser.strln(@"FXOS8700 driver failed to start - halting")
        repeat

    sensor.preset_active()

    repeat
        ser.pos_xy(0, 3)
        show_accel_data()
        show_mag_data()
        if ( ser.getchar_noblock() == "c" )
            cal_accel()
            cal_mag()

#include "acceldemo.common.spin2h"              ' use code common to all accelerometer
#include "magdemo.common.spin2h"                '   and magnetometer demos


DAT
